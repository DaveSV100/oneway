    { "source": "/app", "destination": "https://infinistart.vercel.app/app" },
    { "source": "/app/:path*", "destination": "https://infinistart.vercel.app/app/:path*" },
    { "source": "/store/:path*", "destination": "https://infinistart.vercel.app/store/:path*" },
    { "source": "/c/:path*", "destination": "https://infinistart.vercel.app/c/:path*" },
    { "source": "/r/:path*", "destination": "https://infinistart.vercel.app/r/:path*" },
    { "source": "/auth/:path*", "destination": "https://infinistart.vercel.app/auth/:path*" },
    { "source": "/cuenta", "destination": "https://infinistart.vercel.app/cuenta" },
    { "source": "/negocios/:path*", "destination": "https://infinistart.vercel.app/negocios/:path*" },
    { "source": "/invitacion/:path*", "destination": "https://infinistart.vercel.app/invitacion/:path*" },
    { "source": "/para/:path*", "destination": "https://infinistart.vercel.app/para/:path*" },
    { "source": "/entrar", "destination": "https://infinistart.vercel.app/entrar" },
    { "source": "/registro", "destination": "https://infinistart.vercel.app/registro" },
    { "source": "/empresa", "destination": "https://infinistart.vercel.app/empresa" },
    { "source": "/privacidad", "destination": "https://infinistart.vercel.app/privacidad" },
    { "source": "/aviso-de-privacidad", "destination": "https://infinistart.vercel.app/privacidad" },
    { "source": "/eliminar-cuenta", "destination": "https://infinistart.vercel.app/privacidad" },
    { "source": "/terminos", "destination": "https://infinistart.vercel.app/terminos" },
    { "source": "/soporte", "destination": "https://infinistart.vercel.app/soporte" },
    { "source": "/sin-conexion", "destination": "https://infinistart.vercel.app/sin-conexion" },
    { "source": "/sw.js", "destination": "https://infinistart.vercel.app/sw.js" },
    { "source": "/manifest.webmanifest", "destination": "https://infinistart.vercel.app/manifest.webmanifest" },
