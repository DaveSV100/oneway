    { "source": "/brand/:path*", "destination": "https://infinistart.vercel.app/brand/:path*" },
    { "source": "/icon.svg", "destination": "https://infinistart.vercel.app/icon.svg" },
    { "source": "/apple-icon.png", "destination": "https://infinistart.vercel.app/apple-icon.png" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
